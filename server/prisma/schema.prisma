generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String        @unique @db.VarChar(255)
  passwordHash        String        @db.VarChar(255)
  fullName            String        @db.VarChar(100)
  avatarUrl           String?       @db.VarChar(500)
  isEmailVerified     Boolean       @default(false)
  twoFactorEnabled    Boolean       @default(false)
  twoFactorSecret     String?       @db.VarChar(255)
  backupCodes         Json          @default("[]")
  failedLoginAttempts Int           @default(0)
  lockedUntil         DateTime?     @db.Timestamptz(6)
  createdAt           DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  categories          Category[]
  notes               Note[]
  tasks               Task[]
  transactions        Transaction[]
  wallets             Wallet[]
  tags                Tag[]

  @@map("users")
}

model Wallet {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @db.Uuid
  name           String        @db.VarChar(100)
  currency       String        @default("VND") @db.VarChar(10)
  initialBalance Decimal       @default(0.00) @db.Decimal(15, 2)
  currentBalance Decimal       @default(0.00) @db.Decimal(15, 2)
  icon           String        @default("wallet") @db.VarChar(50)
  color          String        @default("#6366F1") @db.VarChar(20)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  transfersIn    Transaction[] @relation("DestinationWallet")
  transactions   Transaction[] @relation("SourceWallet")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_wallets_userId")
  @@index([userId, createdAt], map: "idx_wallets_user_created")
  @@map("wallets")
}

model Transaction {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String          @db.Uuid
  walletId            String          @db.Uuid
  destinationWalletId String?         @db.Uuid
  type                TransactionType
  amount              Decimal         @db.Decimal(15, 2)
  category            String          @db.VarChar(100)
  transactionDate     DateTime        @db.Timestamptz(6)
  note                String?
  receiptUrl          String?         @db.VarChar(500)
  createdAt           DateTime        @default(now()) @db.Timestamptz(6)
  destinationWallet   Wallet?         @relation("DestinationWallet", fields: [destinationWalletId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wallet              Wallet          @relation("SourceWallet", fields: [walletId], references: [id], onUpdate: NoAction)

  @@index([transactionDate], map: "idx_transactions_date")
  @@index([userId], map: "idx_transactions_userId")
  @@index([walletId], map: "idx_transactions_walletId")
  @@index([destinationWalletId], map: "idx_transactions_destWalletId")
  @@index([userId, transactionDate(sort: Desc)], map: "idx_transactions_user_date")
  @@index([userId, type, transactionDate(sort: Desc)], map: "idx_transactions_user_type_date")
  @@index([userId, category, transactionDate(sort: Desc)], map: "idx_transactions_user_cat_date")
  @@index([userId, walletId], map: "idx_transactions_user_wallet")
  @@map("transactions")
}

model Category {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  name      String    @db.VarChar(100)
  type      String    @default("EXPENSE") @db.VarChar(20)
  icon      String?   @default("tag") @db.VarChar(50)
  color     String?   @default("#6366F1") @db.VarChar(30)
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_categories_userId")
  @@index([userId, createdAt], map: "idx_categories_user_created")
  @@index([userId, name], map: "idx_categories_user_name")
  @@map("categories")
}

model Task {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @db.Uuid
  title          String       @db.VarChar(255)
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?    @db.Timestamptz(6)
  isRecurring    Boolean      @default(false)
  recurrenceRule String?      @db.VarChar(50)
  completedAt    DateTime?    @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  tags           Json?        @default("[]")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([dueDate], map: "idx_tasks_dueDate")
  @@index([status], map: "idx_tasks_status")
  @@index([userId], map: "idx_tasks_userId")
  @@index([userId, status, priority, dueDate], map: "idx_tasks_user_status_priority_due")
  @@index([userId, dueDate], map: "idx_tasks_user_due")
  @@map("tasks")
}

model Note {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String                   @db.Uuid
  title        String                   @db.VarChar(255)
  content      String
  color        String                   @default("#FFFFFF") @db.VarChar(20)
  tags         Json                     @default("[]")
  isPinned     Boolean                  @default(false)
  searchVector Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, (((COALESCE(title, ''::character varying))::text || ' '::text) || COALESCE(content, ''::text)))"))
  createdAt    DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  attachments  Attachment[]
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([isPinned], map: "idx_notes_isPinned")
  @@index([searchVector], map: "idx_notes_searchVector", type: Gin)
  @@index([userId], map: "idx_notes_userId")
  @@index([userId, isPinned, updatedAt(sort: Desc)], map: "idx_notes_user_pinned_updated")
  @@map("notes")
}

model Attachment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  noteId    String   @db.Uuid
  fileName  String   @db.VarChar(255)
  fileKey   String   @db.VarChar(500)
  fileType  String   @db.VarChar(100)
  fileSize  Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([noteId], map: "idx_attachments_noteId")
  @@map("attachments")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Tag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  name      String   @db.VarChar(100)
  color     String   @default("#6366F1") @db.VarChar(30)
  type      String   @default("TASK") @db.VarChar(20)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, type, name], map: "idx_tags_user_type_name")
  @@index([userId, type], map: "idx_tags_user_type")
  @@map("tags")
}
