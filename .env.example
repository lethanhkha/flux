# ==========================================
# FLUX WORKSPACE - ENVIRONMENT TEMPLATE
# ==========================================

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=flux_user
POSTGRES_PASSWORD=flux_secure_password_2026
POSTGRES_DB=flux_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://flux_user:flux_secure_password_2026@localhost:5432/flux_db?schema=public

# Redis Configuration (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=flux_redis_secure_pass_2026
REDIS_URL=redis://:flux_redis_secure_pass_2026@localhost:6379

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# JWT & Authentication Security (Use at least 32-character random strings in production)
JWT_ACCESS_SECRET=flux_super_secret_jwt_access_key_2026_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=flux_super_secret_jwt_refresh_key_2026_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=flux_cookie_secret_signing_key_2026

# Email / Verification (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Flux Workspace <no-reply@fluxworkspace.com>"

# Object Storage (AWS S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=flux-attachments
