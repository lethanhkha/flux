# ==========================================
# FLUX WORKSPACE - ENVIRONMENT TEMPLATE
# ==========================================

# Database Configuration (PostgreSQL 17 / Supabase Pooler)
DATABASE_URL=postgresql://flux_app.your_project_ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Project Credentials
SUPABASE_PROJECT_REF=your_supabase_project_ref
SUPABASE_URL=https://your_supabase_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_jwt_key

# Redis Configuration (Optional - falls back to in-memory if offline)
REDIS_URL=redis://localhost:6379

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# JWT & Authentication Security (Minimum 32 characters)
JWT_ACCESS_SECRET=flux_super_secret_jwt_access_key_2026_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=flux_super_secret_jwt_refresh_key_2026_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=flux_cookie_secret_signing_key_2026

# Gmail SMTP Configuration (Gửi mã OTP 6 số qua Gmail)
# Tạo App Password 16 ký tự tại: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Google OAuth2 Credentials (Đăng nhập Google)
# Tạo OAuth Client ID tại: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Cloudflare Turnstile Anti-Bot Security (Chống bot tự động)
# Tạo Widget tại: https://dash.cloudflare.com/?to=/:account/turnstile
# Mặc định sử dụng Testing Key của Cloudflare (luôn pass an toàn trong dev)
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CLOUDFLARE_TURNSTILE_ENABLED=true
